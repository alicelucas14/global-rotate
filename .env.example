# ---- Domain pool (comma-separated, priority order). Overrides lib/domains.js ----
DOMAINS=https://your-primary-domain.com,https://your-mirror-1.com,https://your-project.vercel.app

# ---- Persistent state (optional but recommended). Free tier at upstash.com ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Email alerts on block/rotation (optional). Free tier at resend.com ----
RESEND_API_KEY=
ALERT_FROM=Rotator <alerts@yourdomain.com>
ALERT_TO=you@example.com,teammate@example.com
